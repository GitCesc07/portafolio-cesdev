---
import { undefined } from "astro:schema";

const currentYear = new Date().getFullYear();
const apiUrlLocal = import.meta.env.local.PUBLIC_API_URL;
const apiUrlProduction = import.meta.env.PUBLIC_API_URL;
---

<footer
  class="rounded-lg shadow m-4 bg-black/5 dark:bg-black/20 backdrop-blur-lg w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center max-sm:p-4"
>
  <div
    class="w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between"
  >
    <span class="text-sm sm:text-center text-zinc-800/90 dark:text-zinc-200/90"
      >© {currentYear}
      {
        apiUrlLocal != "" || apiUrlLocal != null || apiUrlLocal != undefined ?
        (
          <a href={apiUrlLocal} class="hover:underline">CescDev.</a>
        )
        :
        apiUrlProduction != "" || apiUrlProduction != null || apiUrlProduction != undefined ?
        (
          <a href={apiUrlProduction} class="hover:underline">CescDev.</a>
        )
        :
        null
      }
      Casi todos los derechos
      reservados.
    </span>
    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0"
    >
      <li>
        <a href="/#sobre-mi" class="hover:underline me-4 md:me-6">Sobre mí</a>
      </li>
      <li>
        <a href="mailto:cesar04071997@gmail.com" class="hover:underline"
          >Contacto</a
        >
      </li>
    </ul>
  </div>
</footer>
